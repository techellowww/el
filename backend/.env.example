# EL App Dedicated Node.js Socket.IO Chat Server & Background Worker Configuration
PORT=5001
CHAT_SERVER_PORT=5001
DATABASE_URL="postgresql://username:password@localhost:5432/el_app?schema=el_system"
JWT_SECRET="your_strong_jwt_secret_key_here"
CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Automated Email Notifications (Optional for standalone worker)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="EL App Notifications <notifications@yourdomain.com>"
