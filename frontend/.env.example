# EL App Next.js Frontend & Primary API Backend Environment Variables
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/el_app?schema=el_system"
JWT_SECRET="your_strong_jwt_secret_key_here"

# Public Client Configuration (Exposed to browser)
NEXT_PUBLIC_APP_NAME="EL App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:5001"

# Application Timezone
APP_TIMEZONE="Asia/Kolkata"

# Automated SMTP Email Service (Server-side only)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="EL App Notifications <notifications@yourdomain.com>"
